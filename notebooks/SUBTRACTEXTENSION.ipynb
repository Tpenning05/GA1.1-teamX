   "source": [
    "def subtract(a, b):\n",
    "    return a - b\n",
    "\n",
    "\n",
    "def distance_from_zero(x):\n",
    "    if x >= 0:\n",
    "        return subtract(x, 0)\n",
    "    else:\n",
    "        return subtract(0, x)\n",
    "\n",
    "\n",
    "print(distance_from_zero(-5))\n",
    "print(distance_from_zero(5))"
   ]
  }
